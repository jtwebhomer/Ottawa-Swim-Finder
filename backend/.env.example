# Required — generate a long random string
API_KEY=change-me-to-a-long-random-secret

# Server
HOST=0.0.0.0
PORT=3000

# Database
DATABASE_PATH=./data/ottawa_swim.db

# Scheduler — every 6 hours
SYNC_CRON=0 */6 * * *

# Playwright
PLAYWRIGHT_HEADLESS=true

# Windows: use Task Scheduler for sync (not node-cron)
USE_WINDOWS_TASK_SCHEDULER=true
